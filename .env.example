# Copy to .env and fill in. Use read-only access everywhere.

# Hyperliquid: public wallet address (0x...). No private key needed to read.
HYPERLIQUID_WALLET_ADDRESS=

# OKX: API key created with "Read" permission only.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Lighter: L1 wallet address (0x...), or the account index directly.
LIGHTER_WALLET_ADDRESS=
LIGHTER_ACCOUNT_INDEX=
